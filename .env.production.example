PORT=3000
NODE_ENV=production

# Database (PostgreSQL 14+)
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=bugradar
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=bugradar
DB_POOL_MAX=20

# Redis 7+
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# JWT Secrets — MUST be at least 32 characters, generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS

# SMTP (for email alerts and verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=BugRadar <noreply@yourdomain.com>

# CORS — your production domain
CORS_ORIGIN=https://yourdomain.com

# Webhook secret — generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS
